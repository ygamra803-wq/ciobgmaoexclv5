{
  "name": "gmao-app",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node --import tsx/esm server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run src/tests/integration",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\""
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.14",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.16",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fake-indexeddb": "^6.2.5",
    "hyperformula": "^3.4.0",
    "lucide-react": "^1.35.0",
    "lz-string": "^1.5.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "react-window": "^2.3.0",
    "recharts": "^3.10.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
