# إلزامي للإنتاج — ولّد القيم بأمر: openssl rand -hex 32 (ضعها في .env.local ولا تضع أسراراً حقيقية في Git)
VITE_SECRET_KEY=
VITE_CRYPTO_KEY=
# مفتاح شبكة LAN المشترك + سر توقيع جلسات الخادم (HMAC-SHA256، >= 16 حرفاً عشوائياً)
# إلزامي في الإنتاج (NODE_ENV=production): ولّد بـ openssl rand -hex 32
# الكتابة على الخادم بعد التهيئة تتطلب حساباً مسجلاً + جلسة موقعة عبر POST /api/gmao/auth/login
GMAO_API_TOKEN=
GMAO_SESSION_SECRET=
