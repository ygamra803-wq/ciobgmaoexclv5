# إلزامي للإنتاج — ولّد القيم بأمر: openssl rand -hex 32 (ضعها في .env.local ولا تضع أسراراً حقيقية في Git)
VITE_SECRET_KEY=
VITE_CRYPTO_KEY=
# مفتاح شبكة LAN المشترك + سر توقيع جلسات الخادم (HMAC-SHA256، >= 16 حرفاً عشوائياً)
# إلزامي في الإنتاج (NODE_ENV=production): ولّد بـ openssl rand -hex 32
# الكتابة على الخادم بعد التهيئة تتطلب حساباً مسجلاً + جلسة موقعة عبر POST /api/gmao/auth/login
GMAO_API_TOKEN=
GMAO_SESSION_SECRET=

# ---------------------------------------------------------------------------
# إعدادات اختيارية لمحرك SQLite المحلي (تعمل تلقائياً بالقيم الافتراضية دون الحاجة لإدخالها)
# أزل علامة # فقط إذا أردت تخصيص المسار على حاسوب Windows المحلي:
# GMAO_STORAGE_ENGINE=sqlite
# GMAO_DATA_DIR=./data
# GMAO_DB_FILE=./data/ciob_gmao.db
# GMAO_SQLITE_JOURNAL_MODE=WAL
# GMAO_BACKUP_RETENTION=10
