# Auto-detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Explicit Text files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# 📦 Standard Git Binary Configuration for Excel Templates and Workbooks
*.xlsx binary
*.xls binary
*.xlsm binary
*.xlsb binary
*.csv text eol=lf

# 📦 Standard Git Binary Configuration for Binary Assets & Archives
*.pdf binary
*.zip binary
*.tar.gz binary
*.7z binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.sqlite binary
*.db binary
